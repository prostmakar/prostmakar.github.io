---
// Шапка внутренних страниц: хлебные крошки, заголовок, подзаголовок, фото фоном
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { site } from '../data/site';

interface Props {
  title: string;
  lead?: string;
  crumbs: { label: string; href?: string }[];
  image?: ImageMetadata;
}
const { title, lead, crumbs, image } = Astro.props;
const all = [{ label: 'Главная', href: '/' }, ...crumbs];
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: all.map((c, i) => ({
    '@type': 'ListItem', position: i + 1, name: c.label,
    ...(c.href ? { item: new URL(c.href, site.url).href } : {}),
  })),
};
---
<section class="ph">
  {image && <Image class="ph__bg" src={image} alt="" widths={[800, 1400, 2000]} sizes="100vw" loading="eager" />}
  <div class="container ph__inner">
    <nav class="ph__crumbs" aria-label="Хлебные крошки">
      {all.map((c, i) => (
        <>
          {c.href && i < all.length - 1 ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}
          {i < all.length - 1 && <span class="ph__sep">/</span>}
        </>
      ))}
    </nav>
    <h1>{title}</h1>
    {lead && <p class="ph__lead">{lead}</p>}
    <slot />
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
</section>

<style>
  .ph { position: relative; background: var(--graphite); color: var(--white); overflow: hidden; isolation: isolate; }
  .ph__bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; opacity: .35; }
  .ph::before { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(90deg, rgb(20 20 22 / .95) 30%, rgb(20 20 22 / .55)); }
  /* фирменный диагональный срез */
  .ph::after {
    content: ''; position: absolute; right: -40px; top: -20%; bottom: -20%; width: 28px;
    background: var(--red); transform: skewX(-18deg); box-shadow: -10px 0 0 rgb(255 255 255 / .6);
  }
  .ph__inner { padding-block: clamp(48px, 7vw, 96px); }
  .ph__crumbs { display: flex; flex-wrap: wrap; gap: 8px; font-size: .85rem; color: var(--steel-400); margin-bottom: 24px; }
  .ph__crumbs a { text-decoration: none; }
  .ph__crumbs a:hover { color: var(--white); }
  .ph__sep { opacity: .4; }
  .ph h1 { font-size: clamp(1.6rem, 4.6vw, 3.6rem); max-width: 900px; }
  .ph__lead { margin: 20px 0 0; max-width: 680px; font-size: clamp(1.02rem, 1.5vw, 1.18rem); color: var(--steel-200); }
  @media (max-width: 760px) { .ph::after { display: none; } }
</style>
