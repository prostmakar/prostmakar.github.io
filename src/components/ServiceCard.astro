---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import type { Service } from '../data/services';

interface Props { service: Service; index: number }
const { service: s, index } = Astro.props;
---
<a class="sc reveal" href={`/${s.slug}/`}>
  <div class="sc__media">
    <Image src={s.image} alt={s.title} widths={[480, 720, 960]} sizes="(max-width: 680px) 100vw, (max-width: 1024px) 50vw, 400px" />
    <span class="sc__num">{String(index + 1).padStart(2, '0')}</span>
  </div>
  <div class="sc__body">
    <h3>{s.title}</h3>
    <p>{s.short}</p>
    <dl class="sc__specs">
      {s.specs.slice(0, 2).map((sp) => (
        <div><dt>{sp.label}</dt><dd>{sp.value}</dd></div>
      ))}
    </dl>
    <span class="link-arrow">Подробнее <Icon name="arrow" /></span>
  </div>
</a>

<style>
  .sc {
    display: flex; flex-direction: column; text-decoration: none; background: var(--white);
    border: 1px solid var(--steel-100); border-radius: var(--radius); overflow: hidden;
    transition: box-shadow .3s var(--ease), transform .3s var(--ease), border-color .3s;
  }
  .sc:hover { box-shadow: 0 18px 40px rgb(0 0 0 / .1); transform: translateY(-4px); border-color: transparent; }
  .sc__media { position: relative; aspect-ratio: 16 / 10; overflow: hidden; background: var(--steel-100); }
  .sc__media img { width: 100%; height: 100%; object-fit: cover; transition: transform .6s var(--ease); }
  .sc:hover .sc__media img { transform: scale(1.05); }
  .sc__num {
    position: absolute; left: 0; bottom: 0; padding: 8px 18px 8px 14px;
    background: var(--red); color: var(--white); font-weight: 800; font-size: .9rem; letter-spacing: .05em;
    clip-path: polygon(0 0, 100% 0, 82% 100%, 0 100%);
  }
  .sc__body { display: flex; flex-direction: column; flex: 1; padding: 28px 26px 26px; }
  .sc h3 { margin-bottom: 8px; }
  .sc p { color: var(--steel-600); font-size: .95rem; margin-bottom: 20px; }
  .sc__specs { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin: auto 0 22px; padding-top: 18px; border-top: 1px solid var(--steel-100); }
  .sc__specs dt { font-size: .75rem; color: var(--steel-600); text-transform: uppercase; letter-spacing: .06em; }
  .sc__specs dd { margin: 2px 0 0; font-weight: 800; font-size: 1.1rem; }
</style>
