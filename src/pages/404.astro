---
import Base from '../layouts/Base.astro';
import { services } from '../data/services';
---
<Base title="Страница не найдена | ДС-Металл" description="Страница не найдена." noindex>
  <section class="section nf">
    <div class="container">
      <span class="nf__code">404</span>
      <h1>Страница не найдена</h1>
      <p class="lead">Возможно, она переехала после обновления сайта. Вот куда можно перейти:</p>
      <div class="nf__links">
        <a href="/" class="btn">На главную</a>
        <a href="#" class="btn btn--ghost" data-request>Отправить чертёж</a>
      </div>
      <ul class="nf__list">
        {services.map((s) => <li><a href={`/${s.slug}/`}>{s.title}</a></li>)}
      </ul>
    </div>
  </section>
</Base>

<style>
  .nf__code { font-size: clamp(5rem, 16vw, 10rem); font-weight: 800; color: var(--red); line-height: 1; }
  .nf h1 { margin: 12px 0 16px; }
  .nf__links { display: flex; flex-wrap: wrap; gap: 14px; margin: 28px 0 40px; }
  .nf__list { display: flex; flex-wrap: wrap; gap: 8px 24px; padding: 0; list-style: none; }
  .nf__list a { color: var(--steel-600); }
  .nf__list a:hover { color: var(--red); }
</style>
