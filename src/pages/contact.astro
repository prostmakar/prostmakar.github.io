---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import RequestForm from '../components/RequestForm.astro';
import { site, tel } from '../data/site';
import img from '../assets/photos/shop-overview.jpg';

const mapSrc = `https://yandex.ru/map-widget/v1/?ll=${site.address.lng}%2C${site.address.lat}&z=16&pt=${site.address.lng}%2C${site.address.lat}%2Cpm2rdm&text=${encodeURIComponent('Минск, улица Франциска Скорины, 52к7')}`;
---
<Base
  title="Контакты ДС-Металл — адрес, телефоны, как добраться | Минск"
  description={`Контакты ДС-Металл: ${site.address.full}. Телефон ${site.phones[0].number}, e-mail ${site.emails[0].email}. ${site.hours}.`}
>
  <PageHero title="Контакты" image={img} crumbs={[{ label: 'Контакты' }]}
    lead="Позвоните, напишите в мессенджер или отправьте чертёж через форму — ответим в течение часа в рабочее время." />

  <section class="section">
    <div class="container ct">
      <div class="ct__info">
        <div class="ct__block reveal">
          <h2 class="ct__h">Телефоны</h2>
          {site.phones.map((p) => (
            <a class="ct__line" href={tel(p.number)}><Icon name="phone" /><span><strong>{p.number}</strong><small>{p.label}</small></span></a>
          ))}
        </div>
        <div class="ct__block reveal">
          <h2 class="ct__h">E-mail</h2>
          {site.emails.map((m) => (
            <a class="ct__line" href={`mailto:${m.email}`}><Icon name="mail" /><span><strong>{m.email}</strong><small>{m.label}</small></span></a>
          ))}
        </div>
        <div class="ct__block reveal">
          <h2 class="ct__h">Адрес и режим работы</h2>
          <p class="ct__line"><Icon name="pin" /><span><strong>{site.address.full}</strong><small>Производство и самовывоз</small></span></p>
          <p class="ct__line"><Icon name="clock" /><span><strong>{site.hours}</strong><small>Сб, Вс — выходные</small></span></p>
        </div>
        <div class="ct__msg reveal">
          <a href={site.messengers.telegram} target="_blank" rel="noopener" data-goal="messenger_click"><Icon name="telegram" /> Telegram</a>
          <a href={site.messengers.viber} data-goal="messenger_click"><Icon name="viber" /> Viber</a>
          <a href={site.messengers.whatsapp} target="_blank" rel="noopener" data-goal="messenger_click"><Icon name="whatsapp" /> WhatsApp</a>
        </div>
      </div>

      <div class="ct__form reveal" id="zayavka">
        <span class="eyebrow">Заявка</span>
        <h2>Отправить чертёж на расчёт</h2>
        <p>Расчёт бесплатный, ответим в течение часа.</p>
        <RequestForm id="contact" />
      </div>
    </div>
  </section>

  <section class="map">
    <iframe src={mapSrc} title="Карта: как добраться до ДС-Металл" loading="lazy" allowfullscreen></iframe>
  </section>

  <section class="section section--steel">
    <div class="container req">
      <h2>Реквизиты</h2>
      <p><strong>{site.legalName}</strong><br />УНП {site.unp}<br />{site.address.full}</p>
    </div>
  </section>
</Base>

<style>
  .ct { display: grid; grid-template-columns: 1fr 1.1fr; gap: clamp(32px, 6vw, 80px); align-items: start; }
  .ct__block { margin-bottom: 36px; }
  .ct__h { font-size: .8rem; letter-spacing: .18em; text-transform: uppercase; color: var(--steel-600); margin-bottom: 14px; }
  .ct__line { display: flex; gap: 16px; align-items: flex-start; padding: 12px 0; margin: 0; text-decoration: none; border-bottom: 1px solid var(--steel-100); }
  .ct__line svg { color: var(--red); flex: none; margin-top: 2px; }
  .ct__line span { display: grid; }
  .ct__line strong { font-size: 1.12rem; }
  .ct__line small { color: var(--steel-600); font-size: .85rem; }
  a.ct__line:hover strong { color: var(--red); }
  .ct__msg { display: flex; flex-wrap: wrap; gap: 10px; }
  .ct__msg a { display: inline-flex; align-items: center; gap: 8px; padding: 12px 18px; border: 1px solid var(--steel-200); border-radius: var(--radius); text-decoration: none; font-weight: 700; transition: .2s; }
  .ct__msg a:hover { border-color: var(--red); color: var(--red); }
  .ct__form { background: var(--steel-50); padding: clamp(24px, 4vw, 44px); border-top: 4px solid var(--red); border-radius: var(--radius); }
  .ct__form h2 { font-size: clamp(1.5rem, 2.6vw, 2rem); }
  .ct__form > p { color: var(--steel-600); margin: 10px 0 24px; }
  .map { height: 460px; background: var(--steel-100); }
  .map iframe { width: 100%; height: 100%; border: 0; display: block; }
  .req h2 { font-size: 1.4rem; margin-bottom: 12px; }
  .req p { margin: 0; color: var(--steel-600); }
  @media (max-width: 900px) { .ct { grid-template-columns: 1fr; } .map { height: 360px; } }
</style>
