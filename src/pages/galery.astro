---
// Фотогалерея: показывает ВСЕ фото из src/assets/photos. Новое фото — просто положить файл в папку.
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaSection from '../components/CtaSection.astro';
import hero from '../assets/photos/shop-top.jpg';

// Подписи к фото по имени файла (без подписи — «Производство ДС-Металл»)
const captions: Record<string, string> = {
  'hero-shop': 'Общий вид цеха',
  'shop-overview': 'Цех: лазерный труборез и склад металла',
  'shop-top': 'Производственный цех сверху',
  'laser-sheet': 'Лазерный станок VMADE CNC 2000×6000',
  'laser-tube': 'Лазерный труборез',
  'laser-tube-2': 'Лазерный труборез VMADE',
  'milling-vmc1200': 'Обрабатывающий центр VMC1200',
  'milling-wb630': 'Обрабатывающий центр WB630',
  'milling-hall': 'Участок фрезерной обработки',
  'turning-cnc': 'Токарный станок с ЧПУ TCK46D-8',
  'turning-cnc-hall': 'Участок токарных станков с ЧПУ',
  'turning-manual': 'Универсальный токарный станок',
  'turning-manual-2': 'Токарный участок',
  'welding-area': 'Сварочные посты',
  'welding-frames': 'Партия сварных рам',
  'welding-shop': 'Сварочный участок',
  assembly: 'Слесарная доработка изделий',
  'workshop-laser-weld': 'Участок сборки и лазерной сварки',
};

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/photos/*.{jpg,jpeg,png,webp}', { eager: true });
const photos = await Promise.all(
  Object.entries(files).map(async ([path, mod]) => {
    const name = path.split('/').pop()!.replace(/\.\w+$/, '');
    const full = await getImage({ src: mod.default, width: 1800 });
    return { img: mod.default, full: full.src, caption: captions[name] ?? 'Производство ДС-Металл' };
  }),
);
---
<Base
  title="Фото производства — галерея ДС-Металл, Минск"
  description="Фотографии производства ДС-Металл: лазерные станки, обрабатывающие центры с ЧПУ, токарный и сварочный участки, готовые изделия."
>
  <PageHero title="Фотогалерея" image={hero} crumbs={[{ label: 'Фотогалерея' }]}
    lead="Наше производство без постановочных кадров: оборудование, цеха и изделия в работе." />

  <section class="section">
    <div class="container gal">
      {photos.map((p, i) => (
        <button type="button" class="gal__item" data-full={p.full} data-caption={p.caption} aria-label={`Открыть фото: ${p.caption}`}>
          <Image src={p.img} alt={p.caption} widths={[400, 700]} sizes="(max-width: 600px) 100vw, (max-width: 1024px) 50vw, 33vw" loading={i < 6 ? 'eager' : 'lazy'} />
          <span class="gal__cap">{p.caption}</span>
        </button>
      ))}
    </div>
  </section>

  <dialog class="lb" data-lightbox>
    <button type="button" class="lb__close" data-lb-close aria-label="Закрыть">×</button>
    <button type="button" class="lb__nav lb__prev" data-lb-prev aria-label="Предыдущее">‹</button>
    <figure><img data-lb-img alt="" /><figcaption data-lb-cap></figcaption></figure>
    <button type="button" class="lb__nav lb__next" data-lb-next aria-label="Следующее">›</button>
  </dialog>

  <CtaSection />
</Base>

<style>
  .gal { columns: 3 320px; column-gap: 12px; }
  .gal__item { position: relative; display: block; width: 100%; margin: 0 0 12px; padding: 0; border: 0; background: none; cursor: zoom-in; break-inside: avoid; overflow: hidden; border-radius: var(--radius); }
  .gal__item img { width: 100%; height: auto; transition: transform .6s var(--ease); }
  .gal__item:hover img { transform: scale(1.04); }
  .gal__cap { position: absolute; left: 0; right: 0; bottom: 0; padding: 32px 16px 12px; text-align: left; color: var(--white); font-size: .88rem; font-weight: 600; background: linear-gradient(0deg, rgb(0 0 0 / .75), transparent); opacity: 0; transition: opacity .3s; }
  .gal__item:hover .gal__cap, .gal__item:focus-visible .gal__cap { opacity: 1; }

  .lb { width: 100vw; height: 100dvh; max-width: none; max-height: none; margin: 0; padding: 0; border: 0; background: rgb(10 10 12 / .96); color: var(--white); }
  .lb[open] { display: grid; place-items: center; }
  .lb figure { margin: 0; display: grid; gap: 12px; justify-items: center; }
  .lb img { max-width: 92vw; max-height: 84dvh; object-fit: contain; }
  .lb figcaption { color: var(--steel-200); font-size: .95rem; }
  .lb button { position: absolute; background: none; border: 0; color: var(--white); cursor: pointer; font-size: 2.6rem; line-height: 1; width: 56px; height: 56px; }
  .lb__close { top: 12px; right: 12px; }
  .lb__prev { left: 8px; top: 50%; transform: translateY(-50%); }
  .lb__next { right: 8px; top: 50%; transform: translateY(-50%); }
  .lb button:hover { color: var(--red-400); }
</style>

<script>
  const lb = document.querySelector<HTMLDialogElement>('[data-lightbox]')!;
  const img = lb.querySelector<HTMLImageElement>('[data-lb-img]')!;
  const cap = lb.querySelector<HTMLElement>('[data-lb-cap]')!;
  const items = Array.from(document.querySelectorAll<HTMLElement>('.gal__item'));
  let idx = 0;

  const show = (i: number) => {
    idx = (i + items.length) % items.length;
    img.src = items[idx].dataset.full!;
    img.alt = cap.textContent = items[idx].dataset.caption!;
  };
  items.forEach((el, i) => el.addEventListener('click', () => { show(i); lb.showModal(); }));
  lb.querySelector('[data-lb-close]')!.addEventListener('click', () => lb.close());
  lb.querySelector('[data-lb-prev]')!.addEventListener('click', () => show(idx - 1));
  lb.querySelector('[data-lb-next]')!.addEventListener('click', () => show(idx + 1));
  lb.addEventListener('click', (e) => { if (e.target === lb) lb.close(); });
  document.addEventListener('keydown', (e) => {
    if (!lb.open) return;
    if (e.key === 'ArrowLeft') show(idx - 1);
    if (e.key === 'ArrowRight') show(idx + 1);
  });
</script>
