---
// Общий каркас всех страниц: SEO-теги, микроразметка, Метрика, шапка/подвал, форма заявки
import '@fontsource-variable/manrope';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import RequestModal from '../components/RequestModal.astro';
import MobileBar from '../components/MobileBar.astro';
import { site } from '../data/site';
import defaultOg from '../assets/photos/hero-shop.jpg';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  description: string;
  ogImage?: ImageMetadata;
  noindex?: boolean;
  schema?: Record<string, unknown>[]; // доп. микроразметка страницы
}
const { title, description, ogImage = defaultOg, noindex = false, schema = [] } = Astro.props;

const canonical = new URL(Astro.url.pathname, site.url).href;
const og = await getImage({ src: ogImage, width: 1200, height: 630, format: 'jpg', fit: 'cover' });
const ogUrl = new URL(og.src, site.url).href;

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${site.url}/#org`,
  name: site.legalName,
  alternateName: site.name,
  url: site.url,
  image: ogUrl,
  logo: `${site.url}/favicon.svg`,
  telephone: site.phones[0].number,
  email: site.emails[0].email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    addressLocality: site.address.city,
    postalCode: site.address.postal,
    addressCountry: 'BY',
  },
  geo: { '@type': 'GeoCoordinates', latitude: site.address.lat, longitude: site.address.lng },
  openingHours: site.hoursSchema,
  taxID: site.unp,
};
const ld = [orgSchema, ...schema];
---
<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex, follow" />}
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="theme-color" content="#8a1a28" />
  <meta name="format-detection" content="telephone=no" />

  <meta property="og:type" content="website" />
  <meta property="og:locale" content="ru_RU" />
  <meta property="og:site_name" content={site.name} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogUrl} />

  {ld.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}

  {site.metrikaId && (
    <script is:inline define:vars={{ id: site.metrikaId }}>
      window.__ymId = id;
      (function(m,e,t,r,i,k,a){m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};
      m[i].l=1*new Date();for(var j=0;j<document.scripts.length;j++){if(document.scripts[j].src===r){return;}}
      k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)})
      (window,document,'script','https://mc.yandex.ru/metrika/tag.js','ym');
      ym(Number(id),'init',{clickmap:true,trackLinks:true,accurateTrackBounce:true,webvisor:true});
    </script>
  )}
</head>
<body>
  <a class="visually-hidden" href="#main">Перейти к содержимому</a>
  <Header />
  <main id="main">
    <slot />
  </main>
  <Footer />
  <MobileBar />
  <RequestModal />

  <script>
    import { reachGoal } from '../scripts/metrika';

    // Цели Метрики: клики по телефонам, почте, мессенджерам
    document.addEventListener('click', (e) => {
      const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a');
      if (!a) return;
      if (a.dataset.goal) reachGoal(a.dataset.goal);
      else if (a.href.startsWith('tel:')) reachGoal('phone_click');
      else if (a.href.startsWith('mailto:')) reachGoal('email_click');
    });

    // Плавное появление блоков при прокрутке
    const io = new IntersectionObserver((entries) => {
      entries.forEach((en) => {
        if (en.isIntersecting) { en.target.classList.add('is-visible'); io.unobserve(en.target); }
      });
    }, { rootMargin: '0px 0px -8% 0px' });
    document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
  </script>
</body>
</html>
